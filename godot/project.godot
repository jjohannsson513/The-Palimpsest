; Engine configuration file.
; The Palimpsest — v0.3  (spherical Voronoi world)
; Generated for Godot 4.2

[application]

config/name="The Palimpsest"
config/description="Turn-based civilisation strategy on a procedural spherical world"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/icons/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_environment="res://assets/environment/default_env.tres"

[input]

orbit_drag={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"device":-1,"button_index":1,"pressed":true,"script":null)]
}
zoom_in={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"device":-1,"button_index":4,"pressed":true,"script":null)]
}
zoom_out={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"device":-1,"button_index":5,"pressed":true,"script":null)]
}
end_turn={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":4194309,"script":null)]
}
toggle_observe={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":79,"script":null)]
}
